# =============================================================================
# Azure Infrastructure MCP Server Configuration
# =============================================================================
#
# QUICK START (choose one):
#
# 1. ZERO CONFIG - Set subscription in chat using list_subscriptions & set_subscription
#
# 2. MINIMAL - Just set subscription ID (uses 'az login' credentials)
#    AZURE_SUBSCRIPTION_ID=xxx-xxx-xxx
#
# 3. FULL - Service Principal for production/automation
#    AZURE_SUBSCRIPTION_ID=xxx-xxx-xxx
#    AZURE_TENANT_ID=xxx-xxx-xxx
#    AZURE_CLIENT_ID=xxx-xxx-xxx
#    AZURE_CLIENT_SECRET=xxx
#
# =============================================================================

# -----------------------------------------------------------------------------
# Azure Authentication
# -----------------------------------------------------------------------------

# Your Azure subscription ID (get with: az account show --query id -o tsv)
# Leave empty to set via chat using set_subscription tool
AZURE_SUBSCRIPTION_ID=

# Service Principal credentials (optional - leave empty to use 'az login')
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Default region for new resources
AZURE_DEFAULT_LOCATION=eastus

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# API request timeout (seconds)
API_TIMEOUT=30

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Debug mode (enables verbose error messages)
DEBUG=false
